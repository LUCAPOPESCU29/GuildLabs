# Copy to .env.local and fill in. Never commit real secrets.

# ── Auth (Discord OAuth) ───────────────────────────────────────────────────
NEXTAUTH_SECRET=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Per-bot Discord client IDs (fall back to the GuildLabs app if unset)
# NEXT_PUBLIC_CHARTIT_CLIENT_ID=
# NEXT_PUBLIC_MAVEN_CLIENT_ID=

# ── AI (Construct / Maven) ─────────────────────────────────────────────────
# Without a key, the builder falls back to its offline generator.
GROQ_API_KEY=

# ── Bot API (the deploy proxy + claim-code redeem) ─────────────────────────
BOT_API_URL=http://localhost:3008
BOT_API_KEY=forge-local-dev

# ── Waitlist (Queen "coming soon" capture) ─────────────────────────────────
# Optional. A Discord webhook URL that receives waitlist signups. When unset,
# the /api/waitlist route still accepts emails so the UI works — it just won't
# forward them anywhere.
WAITLIST_WEBHOOK_URL=
